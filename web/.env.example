# Copy to web/.env.local (never commit it).

# Which networks the app offers, comma-separated. The first is the default; with more than one,
# a switcher appears in the header.
#   aevum = QDay Aevum testnet (chain 44005)
#   fork  = `make fork`: local copy of Aevum on 127.0.0.1:8555 (chain 440050, real tUSD8)
#   local = `make anvil`: empty local chain on 127.0.0.1:8545 (chain 31337, MockUSD8)
NEXT_PUBLIC_NETWORKS=aevum

# Your Checkout on each network (printed by `make deploy-aevum`, `make deploy-fork`, `make deploy-local`).
NEXT_PUBLIC_CHECKOUT_AEVUM=
NEXT_PUBLIC_CHECKOUT_FORK=
NEXT_PUBLIC_CHECKOUT_LOCAL=

# PocketRails on each network (printed by `make deploy-aevum`, `make deploy-fork`, `make deploy-local`).
NEXT_PUBLIC_RAILS_AEVUM=
NEXT_PUBLIC_RAILS_FORK=
NEXT_PUBLIC_RAILS_LOCAL=
# Block PocketRails was deployed at. History is read from here, 1,000 blocks per call.
NEXT_PUBLIC_RAILS_DEPLOY_BLOCK_AEVUM=
NEXT_PUBLIC_RAILS_DEPLOY_BLOCK_FORK=

# Optional. Only scan events from this block onward on the Activity page (speeds it up).
NEXT_PUBLIC_DEPLOY_BLOCK_AEVUM=
NEXT_PUBLIC_DEPLOY_BLOCK_FORK=

# Optional. Enables WalletConnect (mobile wallets via QR). Free at https://cloud.reown.com
# Without it the app still works with browser-extension wallets (MetaMask, Rabby, …).
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional. Where the Docs page's "Source" link and clone command point (your fork, a preview repo…).
# Default: https://github.com/qday-io/aevum-starter-kit
NEXT_PUBLIC_REPO_URL=

# ---- Server only (no NEXT_PUBLIC_ prefix: never sent to the browser) ----

# Enables the relayer (/api/rails/relay): this TEST wallet submits children's signed payments and
# exception requests and pays the gas. Also used by the starter kit's gasless checkout, on
# whichever network the buyer is on. Use a fresh wallet with a little tQDAY, never one that holds
# anything of value. anvil's default keys are public: the relayer accepts them only on
# `make fork` / `make anvil`, and switches gasless off on Aevum testnet.
RELAYER_PRIVATE_KEY=
# Optional. Max transactions the relayer sends per day (per server process). Default 500.
# RELAYER_DAILY_TX_LIMIT=500
# Optional. The header your host sets with the real client IP, for the relayer's rate limit.
# Vercel: x-vercel-forwarded-for · Cloudflare: cf-connecting-ip. Unset: last X-Forwarded-For entry.
# TRUSTED_IP_HEADER=
