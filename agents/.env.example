# Copy to agents/.env (never commit it). Use TEST wallets only.

RPC_URL=https://rpc-test.qday.info
RAILS_ADDRESS=
# Where the web app runs (for publishing and reading charge notes).
APP_URL=http://localhost:3000

# ---- school billing agent (pnpm --filter agents school) ----
# The school's billing key: the account the parent granted billing to. Needs a little tQDAY for gas.
SCHOOL_KEY=
MEAL_PRICE=0.3
# "day" bills one meal per school day (weekends skipped). A number of seconds bills faster, for demos.
BILL_EVERY=day
POLL_SECONDS=10
# Optional, sent once after the normal meal: duplicate | overprice | trick | overcap
DEMO_SCENARIO=

# ---- guardian agent (pnpm --filter agents guardian) ----
# The guardian key the parent set on the vault. Needs a little tQDAY for gas (vetoes only).
GUARDIAN_KEY=
# Known meal price, used before there's a price history.
EXPECTED_PRICE=0.3
# 0 turns off the "charged on a weekend" rule (e.g. for a hosted showcase where judges trigger charges on any day).
GUARDIAN_BLOCK_WEEKENDS=1
# 1 = also review charge notes with Claude (needs Anthropic API credentials, e.g. ANTHROPIC_API_KEY).
AI_REVIEW=0

# ---- guardian smart-account mode (recommended) ----
# Created by contracts/script/DeployGuardianAccount.s.sol. With these set, the guardian agent sends vetoes as
# ERC-4337 user operations signed by a veto-only session key, and doesn't need GUARDIAN_KEY.
GUARDIAN_ACCOUNT=
GUARDIAN_VALIDATOR=
# The agent's session key (a fresh test key; it needs no funds).
GUARDIAN_SESSION_KEY=
BUNDLER_URL=https://bundler.qday.info
